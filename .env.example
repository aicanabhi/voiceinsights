# Copy to .env and fill in. Every value without a default is required --
# the app refuses to start if one is missing.

APP_NAME=VoiceInsights
APP_VERSION=1.0.0
# true also turns on SQL echo (logs every query WITH its parameters) -- keep
# this false anywhere real
DEBUG=false

# ---- PostgreSQL ----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=voiceinsights
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me

# ---- MongoDB (stores the per-organization agent configs) ----
MONGO_URL=mongodb://localhost:27017

# ---- Auth ----
# Anything long and random. Changing it invalidates every issued token.
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Transcription / LLM providers ----
# Per-organization keys live in the agent config (Mongo). These are only
# fallbacks for local testing; the app does not read them during transcription.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
GROQ_API_KEY=

# ---- Redis ----
# Declared but not used by any code yet; kept so config validation passes.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---- Transcription worker ----
# false => run `python -m app.worker` as a separate process (production)
# true  => the API process runs the poller itself (development)
RUN_WORKER_IN_APP=true
WORKER_POLL_SECONDS=5
WORKER_CONCURRENCY=2
WORKER_MAX_ATTEMPTS=3

# ---- Super Admin seed ----
# Used only by app/scripts/create_super_admin.py
SUPER_ADMIN_EMAIL=admin@yourcompany.com
SUPER_ADMIN_PASSWORD=change-me
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PHONE=
